# Copy to .env (git-ignored). On the VPS: /var/www/brasil-bullion/.env, loaded by systemd.

# --- Server only (never sent to the browser) ---
BASE_ENDPOINT=
BASE_API_KEY=
# Optional
LEAD_FUNNEL=
LEAD_AUTOLOGIN_HOSTS=
# Local dev only; defaults to 127.0.0.1
DEV_IP_ADDRESS=

# Cloudflare Turnstile secret. Leave empty locally: `npm run dev` then uses Cloudflare's
# always-pass test key. Required in production when VITE_CAPTCHA_ENABLED=true, or every
# lead is rejected (503).
TURNSTILE_SECRET_KEY=
# Optional comma list; tokens from other hostnames are rejected, e.g. brasil.leadsallyearlong.space
TURNSTILE_HOSTNAMES=

# --- Public, baked into the page at build time (must be set before `npm run build`) ---
# Captcha switch: "true" shows the Turnstile widget and makes the server require it.
# Anything else (or empty) = no captcha; the Turnstile keys are kept but unused.
VITE_CAPTCHA_ENABLED=
# Leave empty locally to use the test key.
VITE_TURNSTILE_SITE_KEY=
# WhatsApp for the 100% bonus banner: digits with country code, e.g. 5511987654321.
# Empty = the button opens WhatsApp and the visitor picks the chat.
VITE_WHATSAPP_NUMBER=

# Leads log (copy of every lead the CRM accepted). Server only.
LEADS_LOG_ENDPOINT=https://alphamastercrm.online/api/leads-logs
LEADS_LOG_API_KEY=
